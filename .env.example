# 내 컴퓨터에서 테스트할 때만 사용합니다. .env 로 이름을 바꾸고 값을 채우세요.
# GitHub Actions에서는 같은 이름으로 Settings > Secrets and variables > Actions 에 넣습니다.

NASA_API_KEY=            # https://api.nasa.gov 에서 무료 발급
IG_USER_ID=              # 내 인스타 비즈니스 계정 ID (숫자)
IG_ACCESS_TOKEN=         # 시스템 사용자 토큰 (만료 없음 권장)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

WP_URL=https://내워드프레스주소
WP_USER=
WP_APP_PASSWORD=         # 워드프레스 사용자 > 프로필 > 애플리케이션 비밀번호

# 선택: Figma 템플릿 연결
FIGMA_TOKEN=
FIGMA_FILE_KEY=
FIGMA_TEMPLATE_NODE=

MAX_POSTS_PER_RUN=1
MAX_POSTS_PER_DAY=4
HASHTAGS_EXTRA=#우주 #천문학 #NASA
